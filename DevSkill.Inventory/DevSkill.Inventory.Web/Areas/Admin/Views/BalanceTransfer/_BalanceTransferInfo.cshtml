@model AddBalanceTransferModel


<!-- Modal -->
<div class="modal fade" id="add-balanceTransfer-modal" tabindex="-1" role="dialog" aria-labelledby="exampleModalLabel" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title fw-bold" id="exampleModalLabel">Balance Transfer</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <!--begin::Form-->
                <form asp-area="Admin" asp-controller="BalanceTransfer" asp-action="AddBalanceTransfer" asp-antiforgery="true" method="post" enctype="multipart/form-data">
                    <!--begin::Body-->
                    <div class="card-body p-3 bg-info">
                        <div class="row">

                            <div class="col-6 bg-body-secondary">
                                <h2>Sender</h2>
                                <div class="mb-3">
                                    <label asp-for="SendingAccountTypeId" class="form-label fw-bold">Sending Account</label>
                                    <select class="form-select" asp-for="SendingAccountTypeId" asp-items="Model.AccountTypes" id="SendingAccountTypeId" required>
                                    </select>
                                    <span asp-validation-for="SendingAccountTypeId" class="text-danger"></span>
                                </div>
                                <div class="mb-3">
                                    <label asp-for="SendingAccountId" class="form-label fw-bold">Sending Account Number</label>
                                    <select class="form-select" asp-for="SendingAccountId" asp-items="Model.SendingAccounts" id="SendingAccountId" required>
                                    </select>
                                    <span asp-validation-for="SendingAccountId" class="text-danger"></span>
                                </div>

                                <div class="mb-3">
                                    <label asp-for="TransferAmount" class="form-label fw-bold">Transfer Amount </label>
                                    <input type="text" class="form-control" asp-for="TransferAmount" id="TransferAmount" placeholder="Amount" aria-describedby="titleHelp" />
                                    <span asp-validation-for="TransferAmount" class="text-danger"></span>
                                    <div id="titleHelp" class="form-text"> </div>
                                </div>
                            </div>


                            <div class="col-6 bg-body-tertiary">
                                <h2>Receiver</h2>
                                <div class="mb-3">
                                    <label asp-for="ReceiveAccountTypeId" class="form-label fw-bold">Receiving Account</label>
                                    <select class="form-select" asp-for="ReceiveAccountTypeId" asp-items="Model.AccountTypes" id="ReceiveAccountTypeId" required>
                                    </select>
                                    <span asp-validation-for="ReceiveAccountTypeId" class="text-danger"></span>
                                </div>
                                <div class="mb-3">
                                    <label asp-for="ReceiveAccountId" class="form-label fw-bold">Sending Account Number</label>
                                    <select class="form-select" asp-for="ReceiveAccountId" asp-items="Model.ReceivingAccounts" id="ReceiveAccountId" required>
                                    </select>
                                    <span asp-validation-for="ReceiveAccountId" class="text-danger"></span>
                                </div>

                                <div class="mb-3">
                                    <label asp-for="Note" class="form-label fw-bold">Note </label>
                                    <input type="text" class="form-control" asp-for="Note" id="Note" placeholder="If have any note" aria-describedby="titleHelp" />
                                    <span asp-validation-for="Note" class="text-danger"></span>
                                    <div id="titleHelp" class="form-text"> </div>
                                </div>
                            </div>
                    </div>
                    <!--end::Body-->
                    <div class="modal-footer">
                        <button type="submit" class="btn btn-primary">Submit</button>
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    </div>
                </form>
                <!--end::Form-->
            </div>
        </div>
    </div>
</div>
