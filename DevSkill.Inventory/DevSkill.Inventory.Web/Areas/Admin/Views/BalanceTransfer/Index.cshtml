@model BalanceTransferListModel

@{
    ViewData["Title"] = "Transfer Account";
}

@section Styles {
    <link rel="stylesheet" href="https://cdn.datatables.net/2.3.0/css/dataTables.dataTables.min.css" />
    <link rel="stylesheet" href="https://cdn.datatables.net/buttons/3.0.2/css/buttons.dataTables.min.css">

}

<!--begin::App Content Header-->
<div class="app-content-header">
    <!--begin::Container-->
    <div class="container-fluid">
        <!--begin::Row-->
        <div class="row">
            <div class="col-sm-6"><h3 class="mb-0 fw-bold">Transfer Account</h3></div>
            <div class="col-sm-6">
                <ol class="breadcrumb float-sm-end">
                    <li class="breadcrumb-item"><a href="#">Dashboard</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Transfer Account</li>
                </ol>
            </div>
        </div>
        <!--end::Row-->
    </div>
    <!--end::Container-->
</div>
<!--end::App Content Header-->
<!--begin::App Content-->
<div class="app-content">
    <!--begin::Container-->
    <div class="container-fluid">
        <!--begin::Row-->
        <div class="row">
            <div class="row">
                <div class="card">
                    <div class="card-header bg-info">
                        <div class="row">
                            <div class="col-md-6 fw-bold"><div>Transfer Account</div></div>
                            <div class="col-md-6 text-end">
                                <button type="button" class="btn btn-primary btn-add-balanceTransfer">
                                    <i class="bi bi-bookmark-plus-fill"></i>Balance Transfer
                                </button>
                            </div>
                        </div>

                    </div>


                    <!-- /.card-header -->
                    <div class="card-body">
                        <table id="balanceTransfer-table" class="table table-bordered  p-3 text-center table-hover">
                            <thead>
                                <tr class="table-primary">
                                    <th>Date</th>
                                    <th>From Account</th>
                                    <th>To Account</th>
                                    <th>Transfer Amount</th>
                                    <th>Note</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                            </tbody>
                            <tfoot>
                                <tr class="table-primary">
                                    <th>Date</th>
                                    <th>From Account</th>
                                    <th>To Account</th>
                                    <th>Transfer Amount</th>
                                    <th>Note</th>
                                    <th>Actions</th>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                    <!-- /.card-body -->

                </div>
                <!-- /.card -->
            </div>
            @Html.Partial("_BalanceTransferInfo", Model.AddBalanceTransferModel)
            <!-- /.col -->
        </div>

        <!--end::Row-->
    </div>
    <!--end::Container-->
</div>
<!--end::App Content-->
@section Scripts {
    <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>
    <script src="https://cdn.datatables.net/2.2.2/js/dataTables.min.js"></script>

    <script src="https://cdn.datatables.net/buttons/3.0.2/js/dataTables.buttons.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jszip/3.10.1/jszip.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/pdfmake/0.2.7/pdfmake.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/pdfmake/0.2.7/vfs_fonts.js"></script>
    <script src="https://cdn.datatables.net/buttons/3.0.2/js/buttons.html5.min.js"></script>
    <script src="https://cdn.datatables.net/buttons/3.0.2/js/buttons.print.min.js"></script>


    <script>
        $(function(){
             $("#balanceTransfer-table").DataTable({
                 processing: true,
                 serverSide: true,
                 responsive: true,
                 lengthChange: true,
                 autoWidth: false,
                 lengthMenu: [
                     [10, 25, 50, -1],
                     [10, 25, 50, 'All']
                 ],
                 dom: `Bfrtip`,
                 buttons: [
                      'copy', 'csv', 'excel', 'pdf', 'print'
                 ],

                 ajax: {
                      url: '@Url.Action("GetCQRSBalanceTransferJsonData", "BalanceTransfer")',
                      type: 'POST',
                      contentType: "application/json",
                      datatype: 'json',
                      data: function (d) {
                          d.SearchItem = {

                          };
                          return JSON.stringify(d);
                      }
                 },
                 columnDefs: [
                     {
                         orderable: false,
                         targets: 5,
                         render: function(data, type, row){
                                return `
                                <a href="/Admin/BalanceTransfer/RemoveBalanceTransfer/${data}"  value='${data}' class="btn btn-danger">
                                                <i class="bi bi-trash-fill"></i></a>`;
                         }
                     }
                 ],
             });
        });
    </script>

    <script>
        $(document).ready(function () {
            // Handle Edit BalanceTransfer button click
            $(".btn-add-balanceTransfer").on("click", function () {
                $("#add-balanceTransfer-modal").modal("show");
            });
        });
    </script>

    <script>
        $("#SendingAccountTypeId").on('click', function(){
            // alert('call here');
            var postData ={
                accountTypeId : $("#SendingAccountTypeId").val()
            };
            if (postData.accountTypeId === '0' || postData.accountTypeId === "00000000-0000-0000-0000-000000000000") {
                console.log('return for 0');
                return;
            }
            // console.log('postData: ',postData);
            // addAntiForgeryToken(postData);
                $.ajax({
                    cache: false,
                    url: '@Url.Action("GetAccountInfoJsonData", "BalanceTransfer")',
                    type: 'POST',
                    data: postData,
                    success: function (data) {
                        // console.log('data: ', data);
                        var sendingAccountSelect = $('#SendingAccountId');
                        sendingAccountSelect.empty(); // Clear old options

                        $.each(data, function (i, item) {
                            sendingAccountSelect.append(
                                $('<option></option>').val(item.value).text(item.text)
                            );
                        });
                    },
                    error: function (xhr, status, error) {
                        console.error('AJAX error:', error);
                    }
              });
        });
    </script>



    <script>
        $("#ReceiveAccountTypeId").on('click', function(){
            // alert('call here');
            var postData ={
                accountTypeId : $("#ReceiveAccountTypeId").val()
            };
            if (postData.accountTypeId === '0' || postData.accountTypeId === "00000000-0000-0000-0000-000000000000") {
                console.log('return for 0');
                return;
            }
            // console.log('postData: ',postData);
            // addAntiForgeryToken(postData);
                $.ajax({
                    cache: false,
                    url: '@Url.Action("GetAccountInfoJsonData", "BalanceTransfer")',
                    type: 'POST',
                    data: postData,
                    success: function (data) {
                        // console.log('data: ', data);
                        var receiveAccountSelect = $('#ReceiveAccountId');
                        receiveAccountSelect.empty(); // Clear old options

                        $.each(data, function (i, item) {
                            receiveAccountSelect.append(
                                $('<option></option>').val(item.value).text(item.text)
                            );
                        });
                    },
                    error: function (xhr, status, error) {
                        console.error('AJAX error:', error);
                    }
              });
        });
    </script>
    <partial name="_ValidationScriptsPartial" />

     

}