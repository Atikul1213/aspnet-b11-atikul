@model SalesListModel

@{
    ViewData["Title"] = "Sale";
}

@section Styles {
    <link rel="stylesheet" href="https://cdn.datatables.net/2.3.0/css/dataTables.dataTables.min.css" />
    <link rel="stylesheet" href="https://cdn.datatables.net/buttons/3.0.2/css/buttons.dataTables.min.css">
}

<!--begin::App Content Header-->
<div class="app-content-header">
    <!--begin::Container-->
    <div class="container-fluid">
        <!--begin::Row-->
        <div class="row">
            <div class="col-sm-6"><h3 class="mb-0 fw-bold">Sales</h3></div>
            <div class="col-sm-6">
                <ol class="breadcrumb float-sm-end">
                    <li class="breadcrumb-item"><a href="#">Dashboard</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Sales</li>
                </ol>
            </div>
        </div>
        <!--end::Row-->
    </div>
    <!--end::Container-->
</div>
<!--end::App Content Header-->
<!--begin::App Content-->
<div class="app-content">
    <!--begin::Container-->
    <div class="container-fluid">

        <div class="col-12">
            <div class="card">
                <div class="card-header">
                    <div class="row">
                        <div class="col-md-6  fw-bold"><div>Sales List</div></div>
                        <div class="col-md-6 text-end">
                            <a class="btn btn-primary btn-sm ms-auto" asp-area="Admin" asp-controller="Sales" asp-action="AddSales">
                                <i class="bi bi-bookmark-plus-fill"></i>New Sales
                            </a>
                        </div>
                    </div>
                    <div class="card-tools">
                        <button type="button" class="btn btn-tool" data-card-widget="collapse">
                            <i class="fas fa-plus"></i>
                        </button>
                    </div>
                </div>
                <!-- /.card-header -->
                <div class="card-body  p-3 bg-info text-white">
                    <div class="row">
                        <div class="col-sm-3">
                            <div class="form-group">
                                <label>Customer Name</label>
                                <input type="text" asp-for="SearchItem.CustomerName" class="form-control" />
                            </div>
                        </div>
                        <div class="col-sm-3">
                            <div class="form-group">
                                <label>Total From</label>
                                <input type="text" asp-for="SearchItem.TotalFrom" class="form-control" />
                            </div>
                        </div>
                        <div class="col-sm-3">
                            <div class="form-group">
                                <label>Total To</label>
                                <input type="text" asp-for="SearchItem.TotalTo" class="form-control" />
                            </div>
                        </div>
                        <div class="col-sm-3">
                            <div class="form-group">
                                <label>Date From</label>
                                <input type="date" asp-for="SearchItem.DateFrom" class="form-control" />
                            </div>
                        </div>
                        <div class="col-sm-3">
                            <div class="form-group">
                                <label>Date To</label>
                                <input type="date" asp-for="SearchItem.DateTo" class="form-control" />
                            </div>
                        </div>
                        <div class="col-sm-3"> 
                            <div class="form-group">
                                <label>Sales Status</label>
                                <select asp-for="SearchItem.StatusId" asp-items="Model.Status" class="form-control">
                                    <option value="">-- Select Status --</option>
                                </select>
                            </div>
                        </div>
                    </div>
                </div>
                <!-- /.card-body -->
                <div class="card-footer">
                    <button id="searchButton" type="submit" class="btn btn-primary float-right">Search</button>
                </div>
            </div>
        </div>

        <!--begin::Row-->
        <div class="row">
            <div class="col-md-12">
                <div class="card">
                    <div class="card-header"><h3 class="card-title">Available Sales</h3></div>
                    <!-- /.card-header -->
                    <div class="card-body">
                        <table id="sales-table" class="table table-bordered text-center table-hover">
                            <thead>
                                <tr class="table-primary">
                                    <th>In. No.</th>
                                    <th>Date</th>
                                    <th>Customer</th>
                                    <th>Total</th>
                                    <th>Paid</th>
                                    <th>Due</th>
                                    <th>Status</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                            </tbody>
                            <tfoot>
                                <tr class="table-primary">
                                    <th>In. No.</th>
                                    <th>Date</th>
                                    <th>Customer</th>
                                    <th>Total</th>
                                    <th>Paid</th>
                                    <th>Due</th>
                                    <th>Status</th>
                                    <th>Actions</th>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                    <!-- /.card-body -->

                </div>
                <!-- /.card -->
            </div>
            <!-- /.col -->
        </div>
        <!--end::Row-->
    </div>
    <!--end::Container-->
</div>
<!--end::App Content-->
@section Scripts {
    <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>
    <script src="https://cdn.datatables.net/2.2.2/js/dataTables.min.js"></script>

    <script src="https://cdn.datatables.net/buttons/3.0.2/js/dataTables.buttons.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jszip/3.10.1/jszip.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/pdfmake/0.2.7/pdfmake.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/pdfmake/0.2.7/vfs_fonts.js"></script>
    <script src="https://cdn.datatables.net/buttons/3.0.2/js/buttons.html5.min.js"></script>
    <script src="https://cdn.datatables.net/buttons/3.0.2/js/buttons.print.min.js"></script>


    <script>
        $(function(){
             $("#sales-table").DataTable({
                 processing: true,
                 serverSide: true,
                 responsive: true,
                 lengthChange: true,
                 autoWidth: false,
                 searching: false,
                 lengthMenu: [
                     [10, 25, 50, -1],
                     [10, 25, 50, 'All']
                 ],
                 dom: `Bfrtip`,
                 buttons: [
                      'copy', 'csv', 'excel', 'pdf', 'print'
                 ],

                 ajax: {
                      url: '@Url.Action("GetCQRSSalesSPJsonData", "Sales")',
                      type: 'POST',
                      contentType: "application/json",
                      datatype: 'json',
                      data: function (d) {
                          const fixedDate = "2025-01-01";
                          const dateFromVal = $("#SearchItem_DateFrom").val();
                          const dateToVal = $("#SearchItem_DateTo").val();
                          d.SearchItem = {
                                CustomerName: $("#SearchItem_CustomerName").val(),
                                StatusId: $("#SearchItem_StatusId").val() == "" ? null : $("#SearchItem_StatusId").val(),
                                TotalFrom: $("#SearchItem_TotalFrom").val() == "" ? null : $("#SearchItem_TotalFrom").val(),
                                TotalTo: $("#SearchItem_TotalTo").val() == "" ? null : $("#SearchItem_TotalTo").val(),
                                DateFrom: (dateFromVal === fixedDate || !dateFromVal) ? null : dateFromVal,
                                DateTo: (dateToVal === fixedDate || !dateToVal) ? null : dateToVal
                          };
                          return JSON.stringify(d);
                      }
                 },
                 columnDefs: [
                     {
                         orderable: false,
                         targets: 7,
                         render: function(data, type, row){
                                return `<a href="/Admin/Sales/ShowSales/${data}"  value='${data}' class="btn btn-danger">
                                               <i class="bi bi-eye-fill"></i></a>
                                <a href="/Admin/Sales/UpdateSales/${data}" data-id="${data}"   value='${data}' class="btn btn-primary">
                                                <i class="bi bi-pencil-fill"></i></a>

                                <a href="/Admin/Sales/DeleteSales/${data}"  value='${data}' class="btn btn-danger">
                                                <i class="bi bi-trash-fill"></i></a>`;
                         }
                     }
                 ],
             });

              $("#searchButton").on('click', function(){
                  $("#sales-table").DataTable().ajax.reload(null, false);
              });

        });
    </script>

    <partial name="_ValidationScriptsPartial" />
}