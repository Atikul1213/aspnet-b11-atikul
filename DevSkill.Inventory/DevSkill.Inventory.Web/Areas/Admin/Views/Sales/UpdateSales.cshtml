@model UpdateSalesModel

@{
    ViewData["Title"] = "Sales";
}

@section Styles {
    <link rel="stylesheet" href="https://cdn.datatables.net/2.3.0/css/dataTables.dataTables.min.css" />
    <link rel="stylesheet" href="https://cdn.datatables.net/buttons/3.0.2/css/buttons.dataTables.min.css">
}
<!--begin::App Content Header-->
<div class="app-content-header">
    <!--begin::Container-->
    <div class="container-fluid">
        <!--begin::Row-->
        <div class="row">
            <div class="col-sm-6"><h3 class="mb-0">Sales Information</h3></div>
            <div class="col-sm-6">
                <ol class="breadcrumb float-sm-end">
                    <li class="breadcrumb-item"><a href="#">Home</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Sales</li>
                </ol>
            </div>
        </div>
        <!--end::Row-->
        <a class="btn btn-primary" asp-area="Admin" asp-controller="Sales" asp-action="Index">
            Back to sales list
        </a>
    </div>
    <!--end::Container-->
</div>
<!--end::App Content Header-->
<!--begin::App Content-->
<div class="app-content">
    <!--begin::Container-->
    <div class="container-fluid">
        <!--begin::Row-->
        <div class="row g-4">
            <!--begin::Col-->
            <div class="col-md-12">
                <!--begin::Quick Example-->
                <div class="card card-primary card-outline mb-4">
                    <!--begin::Header-->
                    <div class="card-header"><div class="card-title">Update Sales</div></div>
                    <!--end::Header-->
                    <!--begin::Form-->
                    <form asp-area="Admin" asp-controller="Sales" asp-action="AddSales" asp-antiforgery="true" method="post">
                        <!--begin::Body-->
                        <div class="card-body  p-3 bg-info text-white">
                            <div class="row">
                                <div class="col-12">
                                    <input type="hidden" asp-for="Id" />
                                    <div class="row">
                                        <div class="col-3">
                                            <div class="mb-3">
                                                <label asp-for="SaleDate" class="form-label fw-bold">Sale Date </label>
                                                <input type="text" class="form-control" asp-for="SaleDate" id="SaleDate" placeholder="Sales date" aria-describedby="titleHelp" />
                                                <span asp-validation-for="SaleDate" class="text-danger"></span>
                                                <div id="titleHelp" class="form-text"> </div>
                                            </div>
                                        </div>
                                        <div class="col-3">
                                            <div class="mb-3">
                                                <label asp-for="CustomerId" class="form-label fw-bold">Category</label>
                                                <select class="form-select" asp-for="CustomerId" asp-items="Model.Customers" id="CustomerId" required>
                                                </select>
                                                <span asp-validation-for="CustomerId" class="text-danger"></span>
                                            </div>
                                        </div>
                                        <div class="col-3">
                                            <div class="mb-3">
                                                <label asp-for="SalesTypeId" class="form-label fw-bold">Select Sales Type</label>
                                                <select class="form-select" asp-for="SalesTypeId" asp-items="Model.SalesTypes" id="SalesTypeId" required>
                                                </select>
                                                <span asp-validation-for="SalesTypeId" class="text-danger"></span>
                                            </div>
                                        </div>
                                        <div class="col-3">
                                            <div class="mb-3">
                                                <label asp-for="ProductId" class="form-label fw-bold">Select Product</label>
                                                <select class="form-select" asp-for="ProductId" asp-items="Model.Products" id="SalesTypeId" required>
                                                </select>
                                                <span asp-validation-for="ProductId" class="text-danger"></span>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="row">

                                        <table class="table table-bordered text-center table-hover">
                                            <thead>
                                                <tr class="table-primary">
                                                    <th>Code</th>
                                                    <th>Product</th>
                                                    <th>Stock</th>
                                                    <th>Quality</th>
                                                    <th>Unit Price</th>
                                                    <th>Sub Total</th>
                                                    <th>Actions</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                <tr>
                                                    <td>@Model.InvoiceNo</td>
                                                    @* <td>@Model.ProductName</td>
                                                    <td>@Model.Stock</td>
                                                    <td>@Model.Quantity</td>
                                                    <td>@Model.UnitPrice</td> *@
                                                    <td>@Model.TotalAmount</td>
                                                    <td></td>
                                                </tr>
                                                <tr>
                                                    <td colspan="5" class="text-end">
                                                        <label for="VatPercentage">VAT (%)</label>
                                                    </td>
                                                    <td class="text-end">
                                                        <input type="number" class="form-control" asp-for="Vat" id="Vat" placeholder="Enter VAT" aria-describedby="titleHelp" />
                                                    </td>
                                                    <td></td>
                                                </tr>
                                                <tr>
                                                    <td colspan="5" class="text-end">
                                                        <label for="VatPercentage">Net Amount</label>
                                                    </td>
                                                    <td class="text-end">
                                                        <input type="number" class="form-control" asp-for="NetAmount" id="NetAmount" placeholder="Enter net amount" aria-describedby="titleHelp" />
                                                    </td>
                                                    <td></td>
                                                </tr>
                                                <tr>
                                                    <td colspan="5" class="text-end">
                                                        <label for="VatPercentage">Discount</label>
                                                    </td>
                                                    <td class="text-end">
                                                        <input type="number" class="form-control" asp-for="Discount" id="Discount" placeholder="Enter discount" aria-describedby="titleHelp" />
                                                    </td>
                                                    <td></td>
                                                </tr>
                                                <tr>
                                                    <td colspan="5" class="text-end">
                                                        <label for="VatPercentage">Total Amount</label>
                                                    </td>
                                                    <td class="text-end">
                                                        <input type="number" class="form-control" asp-for="TotalAmount" id="TotalAmount" placeholder="Enter total amount" aria-describedby="titleHelp" />
                                                    </td>
                                                    <td></td>
                                                </tr>
                                                <tr>
                                                    <td colspan="5" class="text-end">
                                                        <label for="VatPercentage">Paid Amount</label>
                                                    </td>
                                                    <td class="text-end">
                                                        <input type="number" class="form-control" asp-for="PaidAmount" id="PaidAmount" placeholder="Enter paid amount" aria-describedby="titleHelp" />
                                                    </td>
                                                    <td></td>
                                                </tr>
                                                <tr>
                                                    <td colspan="5" class="text-end">
                                                        <label for="VatPercentage">Due Amount</label>
                                                    </td>
                                                    <td class="text-end">
                                                        <input type="number" class="form-control" asp-for="DueAmount" id="DueAmount" placeholder="Enter due amount" aria-describedby="titleHelp" />
                                                    </td>
                                                    <td></td>
                                                </tr>
                                            </tbody>
                                        </table>
                                    </div>


                                    <div class="row">
                                        <div class="col-4">
                                            <div class="mb-3">
                                                <label asp-for="AccountTypeId" class="form-label fw-bold">Account Type</label>
                                                <select class="form-select" asp-for="AccountTypeId" asp-items="Model.AccountTypes" id="AccountTypeId" required>
                                                </select>
                                                <span asp-validation-for="AccountTypeId" class="text-danger"></span>
                                            </div>
                                        </div>
                                        <div class="col-4">
                                            <div class="mb-3">
                                                <label asp-for="AccountNoId" class="form-label fw-bold">Account No</label>
                                                <select class="form-select" asp-for="AccountNoId" asp-items="Model.Accounts" id="AccountNoId" required>
                                                </select>
                                                <span asp-validation-for="AccountNoId" class="text-danger"></span>
                                            </div>
                                        </div>
                                        <div class="col-4">
                                            <div class="mb-3">
                                                <label asp-for="Note" class="form-label fw-bold">Low Stock</label>
                                                <input type="text" class="form-control" asp-for="Note" id="Note" placeholder="If have any note" aria-describedby="titleHelp" />
                                                <span asp-validation-for="Note" class="text-danger"></span>
                                                <div id="titleHelp" class="form-text"> </div>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="row">
                                        <div class="mb-3">
                                            <label asp-for="TermsAndConditions" class="form-label fw-bold">Terms & Conditions</label>
                                            <textarea class="form-control" asp-for="TermsAndConditions" id="TermsAndConditions" rows="5" placeholder="If have any note"></textarea>
                                            <span asp-validation-for="TermsAndConditions" class="text-danger"></span>
                                            <div id="titleHelp" class="form-text"> </div>
                                        </div>

                                    </div>

                                </div>

                            </div>
                        </div>
                        <!--end::Body-->
                        <div class="modal-footer d-flex justify-content-center">
                            <button type="submit" class="btn btn-primary text-center">Submit</button>
                        </div>
                    </form>
                    <!--end::Form-->
                </div>
                <!--end::Quick Example-->

            </div>
            <!--end::Col-->
        </div>
        <!--end::Row-->
    </div>
    <!--end::Container-->
</div>
<!--end::App Content-->
@section Scripts
{
    <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>
    <partial name="_ValidationScriptsPartial" />

    <script>
        $("#AccountTypeId").on('click', function(){
            // alert('call here');
            var postData ={
                accountTypeId : $("#AccountTypeId").val()
            };
            if (postData.accountTypeId === '0' || postData.accountTypeId === "00000000-0000-0000-0000-000000000000") {
                console.log('return for 0');
                return;
            }
            // console.log('postData: ',postData);
            // addAntiForgeryToken(postData);
                $.ajax({
                    cache: false,
                    url: '@Url.Action("GetAccountInfoJsonData", "Sales")',
                    type: 'POST',
                    data: postData,
                    success: function (data) {
                        // console.log('data: ', data);
                        var sendingAccountSelect = $('#AccountNoId');
                        sendingAccountSelect.empty(); // Clear old options

                        $.each(data, function (i, item) {
                            sendingAccountSelect.append(
                                $('<option></option>').val(item.value).text(item.text)
                            );
                        });
                    },
                    error: function (xhr, status, error) {
                        console.error('AJAX error:', error);
                    }
              });
        });
    </script>
}
