@model ShowSalesModel

@{
    ViewData["Title"] = "Sale INvoice";
}

@section Styles {
    <link rel="stylesheet" href="https://cdn.datatables.net/2.3.0/css/dataTables.dataTables.min.css" />
    <link rel="stylesheet" href="https://cdn.datatables.net/buttons/3.0.2/css/buttons.dataTables.min.css">
}
<!--begin::App Content Header-->
<div class="app-content-header">
    <!--begin::Container-->
    <div class="container-fluid">
        <!--begin::Row-->
        <div class="row">
            <div class="col-sm-6"><h3 class="mb-0">Sales</h3></div>
            <div class="col-sm-6">
                <ol class="breadcrumb float-sm-end">
                    <li class="breadcrumb-item"><a href="#">Dashboard</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Sales</li>
                </ol>
            </div>
        </div>
        <!--end::Row-->
     
    </div>
    <!--end::Container-->
</div>
<!--end::App Content Header-->
<!--begin::App Content-->
<div class="app-content">
    <!--begin::Container-->
    <div class="container-fluid">
        <!--begin::Row-->
        <div class="row g-4">
            <!--begin::Col-->
            <div class="col-md-12">
                <!--begin::Quick Example-->
                <div class="card card-primary card-outline mb-4">
                    <!--begin::Header-->
                    <div class="card-header"><div class="card-title">Sales Information</div></div>
                    <!--end::Header-->
                        <!--begin::Body-->
                        <div class="card-body  p-3  text-black">
                                <div class="row mb-2">
                                    <div class="col-4">
                                         <img style="width: 20%; height: auto;" src="~/images/Logo.png" alt="logo" />
                                    </div>
                                    <div class="col-4 align-content-center">
                                        <p>
                                            69/C,Green Road, Panthapath, Dhaka-1205, Bangladesh
                                            sunshine.com.bd@gmail.com
                                            Contact No.: +8801714044180
                                            www.facebook.com
                                        </p>
                                    </div>

                                    <div class="col-4">
                                         <img style="width: 20%; height: auto;" src="~/images/QRCode.png" alt="logo" />
                                    </div>
                                </div>
                                <hr />
                            <div class="row mt-3">
                                <div class="col-12">
                                    <div class="row">

                                        <div class="col-4">
                                            <div class="mb-3">
                                                <p><strong>Order Date #:</strong> @Model.SaleDate.ToString("dd-MM-yyyy")</p>
                                            </div>
                                            <div class="mb-3">
                                                <p><strong>Order Time #:</strong> @Model.SaleDate.ToString("hh-mm-ss")</p>
                                            </div>
                                            <div class="mb-3">
                                            <p><strong>Company #:</strong> Sunshine IT</p>
                                            </div>
                                            <div class="mb-3">
                                                <p><strong>Salesperson #:</strong> Sunshine IT</p>
                                            </div>
                                        </div>

                                    <div class="col-4 d-flex justify-content-center">
                                        <div class="bg-primary text-white rounded border border-dark p-4 text-center" style="height: 100px; width: 400px;">
                                            <h2 class="m-0">Sale Invoice</h2>
                                        </div>
                                    </div>

                                        <div class="col-4">
                                            <div class="mb-3">
                                                <p><strong>Invoice No #:</strong> @Model.InvoiceNo</p>
                                            </div>
                                            <div class="mb-3">
                                                <p><strong>Customer Name #:</strong> @Model.Customer.Name</p>
                                            </div>
                                            <div class="mb-3">
                                                <p><strong>Address #:</strong> @Model.Customer.Address</p>
                                            </div>
                                            <div class="mb-3">
                                                <p><strong>Contact No #:</strong> @Model.Customer.MobileNumber</p>
                                            </div>
                                        </div>
                                        
                                    </div>

                                    <div class="row mt-3">

                                        <table class="table table-bordered text-center table-hover">
                                            <thead>
                                                <tr class="table-primary">
                                                    <th>SL</th>
                                                    <th>BarCode</th>
                                                    <th>Product</th>
                                                    <th>Quantity</th>
                                                    <th>Unit Price</th>
                                                    <th>Total</th>
                                                </tr>
                                            </thead>
                                            <tbody id="sale-products-body">
                                                <!-- Check if there are any bankAccount to display -->
                                                @if (Model.SaleProducts.Any())
                                                {
                                                    <!-- Loop through each bankAccount in the model's bankAccount list -->
                                                    var idx = 1;
                                                    @foreach (var product in Model.SaleProducts)
                                                    {
                                                        var rowClass = (idx % 2 == 0) ? "table-info" : "table-success";
                                                        <tr class="@rowClass">
                                                            <td class="text-center">@idx</td>
                                                            <td class="text-center">@product.BarCode</td>
                                                            <td class="text-center">@product.Name</td>
                                                            <td class="text-center">@product.Quantity</td>
                                                            <td class="text-center">@product.MRPPrice</td>
                                                            <td class="text-center">@product.SubTotal</td>
                                                        </tr>
                                                        idx++;
                                                    }
                                                }

                                                <tr>
                                                    <td colspan="5" class="text-end">
                                                        <label for="VatPercentage">VAT (%)</label>
                                                    </td>
                                                    <td class="text-center">
                                                        <p>@Model.Vat</p>
                                                    </td>
                                                </tr>
                                                <tr>
                                                    <td colspan="5" class="text-end">
                                                        <label for="VatPercentage">Net Amount</label>
                                                    </td>
                                                <td class="text-center">
                                                        <p>@Model.NetAmount</p>
                                                    </td>
                                                </tr>
                                                <tr>
                                                    <td colspan="5" class="text-end">
                                                        <label for="VatPercentage">Discount</label>
                                                    </td>
                                                <td class="text-center">
                                                        <p>@Model.Discount</p>
                                                    </td>
                                                </tr>
                                                <tr>
                                                    <td colspan="5" class="text-end">
                                                        <label for="VatPercentage">Total Amount</label>
                                                    </td>
                                                <td class="text-center">
                                                        <p>@Model.TotalAmount</p>
                                                    </td>
                                                </tr>
                                                <tr>
                                                    <td colspan="5" class="text-end">
                                                        <label for="VatPercentage">Paid Amount</label>
                                                    </td>
                                                <td class="text-center">
                                                        <p>@Model.PaidAmount</p>
                                                    </td>
                                                </tr>
                                                <tr>
                                                    <td colspan="5" class="text-end">
                                                        <label for="VatPercentage">Due Amount</label>
                                                    </td>
                                                <td class="text-center">
                                                        <p>@Model.DueAmount</p>
                                                    </td>
                                                </tr>
                                            </tbody>
                                        </table>
                                    </div>

                                </div>

                            </div>
                        </div>
                        <!--end::Body-->
                        <div class="modal-footer d-flex justify-content-center">
                            <a class="btn btn-primary" asp-area="Admin" asp-controller="Sales" asp-action="SalesIndex">
                                Back to sales list
                            </a>
                        </div>
                </div>
                <!--end::Quick Example-->

            </div>
            <!--end::Col-->
        </div>
        <!--end::Row-->
    </div>
    <!--end::Container-->
</div>
<!--end::App Content-->
