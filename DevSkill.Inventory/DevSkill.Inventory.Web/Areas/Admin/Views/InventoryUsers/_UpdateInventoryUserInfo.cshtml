@model UpdateInventoryUserModel

<!-- Modal -->
<div class="modal fade" id="update-inventoryUser-modal" tabindex="-1" role="dialog" aria-labelledby="exampleModalLabel" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title fw-bold" id="exampleModalLabel">Update InventoryUser Information</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <!--begin::Form-->
                <form asp-area="Admin" asp-controller="InventoryUsers" asp-action="UpdateInventoryUser" asp-antiforgery="true" method="post">
                    <!--begin::Body-->
                    <div style="background-color:#738199;" class="card-body p-3   text-white">
                        <input asp-for="Id" hidden/>
                        <div class="mb-3">
                            <label asp-for="EmployeeName" class="form-label fw-bold">Employee Name</label>
                            <input type="text" class="form-control" asp-for="EmployeeName" id="EmployeeName" placeholder="EmployeeName" readonly  aria-describedby="titleHelp" />
                            <span asp-validation-for="EmployeeName" class="text-danger"></span>
                            <div id="titleHelp" class="form-text"> </div>
                        </div>
                        <div class="mb-3">
                            <label asp-for="EmployeeId" class="form-label fw-bold">Select Employee</label>
                            <select class="form-select" asp-for="EmployeeId" asp-items="Model.Employees" id="EmployeeId" required>
                            </select>
                            <span asp-validation-for="EmployeeId" class="text-danger"></span>
                        </div>
                        <div class="mb-3">
                            <label asp-for="UserRoleId" class="form-label fw-bold">Select User Role</label>
                            <select class="form-select" asp-for="UserRoleId" asp-items="Model.UserRoles" id="UserRoleId" required>
                            </select>
                            <span asp-validation-for="UserRoleId" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Password" class="form-label fw-bold">Password</label>
                            <input type="text" class="form-control" asp-for="Password" id="Password" placeholder="Password" aria-describedby="titleHelp" />
                            <span asp-validation-for="Password" class="text-danger"></span>
                            <div id="titleHelp" class="form-text"> </div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="StatusId" class="form-label fw-bold">Status</label>
                            <select class="form-select" asp-for="StatusId" asp-items="Model.Status" id="statusId" required>
                            </select>
                            <span asp-validation-for="StatusId" class="text-danger"></span>
                        </div>
                    </div>
                    <!--end::Body-->
                    <div class="modal-footer">
                        <button type="submit" class="btn btn-primary">Submit</button>
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    </div>
                </form>
                <!--end::Form-->
            </div>
        </div>
    </div>
</div>
