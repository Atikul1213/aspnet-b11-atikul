@model SettingModel
@{
    ViewData["Title"] = "Settings";
}

<!--begin::App Content Header-->
<div class="app-content-header">
    <!--begin::Container-->
    <div class="container-fluid">
        <!--begin::Row-->
        <div class="row">
            <div class="col-sm-6"><h3 class="mb-0">Setting</h3></div>
            <div class="col-sm-6">
                <ol class="breadcrumb float-sm-end">
                    <li class="breadcrumb-item"><a href="#">Dashboard</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Setting</li>
                </ol>
            </div>
        </div>
        <!--end::Row-->
    </div>
    <!--end::Container-->
</div>
<!--end::App Content Header-->
<!--begin::App Content-->
<div class="app-content">
    <!--begin::Container-->
    <div class="container-fluid">
        <!--begin::Row-->
        <div class="row">
            <div class="col-md-12">
                <div class="card">
                    <div class="card-header"><h3 class="card-title">Setting</h3></div>
                    <!-- /.card-header -->
                    <div class="card-body">
                      <div class="row">
                            <div class="col-md-3 col-sm-6 col-12">
                                <a asp-area="Admin" asp-controller="Category" asp-action="Index">
                                    <div class="info-box" style="background-color:#c2a5d6;color:black;">
                                        <span class="info-box-icon"><i class="bi bi-list-task"></i></span>
                                        <div class="info-box-content">
                                            <span class="info-box-text">Category</span>
                                            <span class="info-box-number">@Model.CategoryCount</span>
                                        </div>
                                    </div>
                                </a>
                            </div>

                            <div class="col-md-3 col-sm-6 col-12">
                                <a asp-area="Admin" asp-controller="Units" asp-action="Index">
                                    <div class="info-box" style="background-color:#d1c2cb;color:black;">
                                        <span class="info-box-icon"><i class="bi bi-list-task"></i></span>
                                        <div class="info-box-content">
                                            <span class="info-box-text">Unit</span>
                                            <span class="info-box-number">@Model.UnitCount</span>
                                        </div>
                                    </div>
                                </a>
                            </div>

                            <div class="col-md-3 col-sm-6 col-12">
                                <a asp-area ="Admin" asp-controller="Departments" asp-action="Index">
                                    <div class="info-box" style="background-color:#b2bed1;color:black;">
                                        <span class="info-box-icon"><i class="bi bi-list-task"></i></span>
                                        <div class="info-box-content">
                                            <span class="info-box-text">Department</span>
                                            <span class="info-box-number">@Model.DepartmentCount</span>
                                        </div>
                                    </div>
                                </a>
                            </div>

                            <div class="col-md-3 col-sm-6 col-12">
                                <a asp-area="Admin" asp-controller="CashAccounts" asp-action="Index">
                                    <div class="info-box" style="background-color:#f2c2df;color:black;">
                                        <span class="info-box-icon"><i class="bi bi-list-task"></i></span>
                                        <div class="info-box-content">
                                            <span class="info-box-text">Cash Account</span>
                                            <span class="info-box-number">@Model.CashAccountCount</span>
                                        </div>
                                    </div>
                                </a>
                            </div>

                            <div class="col-md-3 col-sm-6 col-12">
                                <a asp-area="Admin" asp-controller="BankAccounts" asp-action="Index">
                                    <div class="info-box" style="background-color:#a0bff2;color:black;">
                                        <span class="info-box-icon"><i class="bi bi-list-task"></i></span>
                                        <div class="info-box-content">
                                            <span class="info-box-text">Bank Account</span>
                                            <span class="info-box-number">@Model.BankAccountCount</span>
                                        </div>
                                    </div>
                                </a>
                            </div>

                            <div class="col-md-3 col-sm-6 col-12">
                                <a asp-area="Admin" asp-controller="MobileAccounts" asp-action="Index">
                                    <div class="info-box" style="background-color:#bebf9f;color:black;">
                                        <span class="info-box-icon"><i class="bi bi-list-task"></i></span>
                                        <div class="info-box-content">
                                            <span class="info-box-text">Mobile Account</span>
                                            <span class="info-box-number">@Model.MobileAccountCount</span>
                                        </div>
                                    </div>
                                </a>
                            </div>

                            <div class="col-md-3 col-sm-6 col-12">
                                <a asp-area="Admin" asp-controller="UserRoles" asp-action="Index">
                                    <div class="info-box" style="background-color:#d0d5db;color:black;">
                                        <span class="info-box-icon"><i class="bi bi-list-task"></i></span>
                                        <div class="info-box-content">
                                            <span class="info-box-text">User Type</span>
                                            <span class="info-box-number">@Model.UserRoleCount</span>
                                        </div>
                                    </div>
                                </a>
                            </div>

                            <div class="col-md-3 col-sm-6 col-12">
                                <a asp-area="Admin" asp-controller="BalanceTransfer" asp-action="Index">
                                    <div class="info-box" style="background-color:#6aa2fc;color:black;">
                                        <span class="info-box-icon"><i class="bi bi-list-task"></i></span>
                                        <div class="info-box-content">
                                            <span class="info-box-text">Balance Transfer</span>
                                            <span class="info-box-number">@Model.TotalTransferAmount</span>
                                        </div>
                                    </div>
                                </a>
                            </div>
                      </div>
                    <!-- /.card-body -->

                </div>
                <!-- /.card -->
            </div>
            <!-- /.col -->
        </div>
        <!--end::Row-->
    </div>
    <!--end::Container-->
</div>
<!--end::App Content-->
@section Scripts {
    <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>
    <script src="https://cdn.datatables.net/2.2.2/js/dataTables.min.js"></script>
}