@model ProductUpdateCommand

@{
    ViewData["Title"] = "Update Product";
}

<!--begin::App Content Header-->
<div class="app-content-header">
    <!--begin::Container-->
    <div class="container-fluid">
        <!--begin::Row-->
        <div class="row">
            <div class="col-sm-6"><h3 class="mb-0">Update Product</h3></div>
            <div class="col-sm-6">
                <ol class="breadcrumb float-sm-end">
                    <li class="breadcrumb-item"><a href="#">Home</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Update Product</li>
                </ol>
            </div>
        </div>
        <!--end::Row-->
        <a class="btn btn-primary" asp-area="Admin" asp-controller="Products" asp-action="ProductIndex">
            Back to product list
        </a>
    </div>
    <!--end::Container-->
</div>
<!--end::App Content Header-->
<!--begin::App Content-->
<div class="app-content">
    <!--begin::Container-->
    <div class="container-fluid">
        <!--begin::Row-->
        <div class="row g-4">
            <!--begin::Col-->
            <div class="col-md-6">
                <!--begin::Quick Example-->
                <div class="card card-primary card-outline mb-4">
                    <!--begin::Header-->
                    <div class="card-header"><div class="card-title">Update Product</div></div>
                    <!--end::Header-->
                    <!--begin::Form-->
                    <form asp-area="Admin" asp-controller="Products" asp-action="EditProduct" asp-antiforgery="true" method="post">
                        <!--begin::Body-->
                        <input asp-for="Id" type="hidden" />
                        <div class="card-body">
                            <div class="mb-3">
                                <label asp-for="Name" class="form-label">Product Name</label>
                                <input type="text" class="form-control" asp-for="Name" id="Name" aria-describedby="titleHelp" />
                                <span asp-validation-for="Name" class="text-danger"></span>
                                <div id="titleHelp" class="form-text"> </div>
                            </div>
                            <div class="mb-3">
                                <label asp-for="Sku" class="form-label">Product Sku</label>
                                <input type="text" class="form-control" asp-for="Sku" id="Sku" aria-describedby="titleHelp" />
                                <span asp-validation-for="Sku" class="text-danger"></span>
                                <div id="titleHelp" class="form-text"> </div>
                            </div>
                            <div class="mb-3">
                                <label asp-for="Price" class="form-label">Price</label>
                                <input type="number" class="form-control" asp-for="Price" id="Price" />
                                <span asp-validation-for="Price" class="text-danger"></span>
                            </div>
                            <div class="mb-3">
                                <label asp-for="Quantity" class="form-label">Quantity</label>
                                <input type="number" class="form-control" asp-for="Quantity" id="Quantity" />
                                <span asp-validation-for="Quantity" class="text-danger"></span>
                            </div>
                            <div class="mb-3">
                                <label asp-for="IsAvailable" class="form-check-label">IsAvailable</label>
                                <input type="checkbox" class="form-check-input" asp-for="IsAvailable" id="IsAvailable" />
                                <span asp-validation-for="IsAvailable" class="text-danger"></span>
                            </div>

                        </div>
                        <!--end::Body-->
                        <!--begin::Footer-->
                        <div class="card-footer">
                            <button type="submit" class="btn btn-primary">Submit</button>
                        </div>
                        <!--end::Footer-->
                    </form>
                    <!--end::Form-->
                </div>
                <!--end::Quick Example-->

            </div>
            <!--end::Col-->
        </div>
        <!--end::Row-->
    </div>
    <!--end::Container-->
</div>
<!--end::App Content-->
@section Scripts
{
    <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>
    <partial name="_ValidationScriptsPartial" />
}
