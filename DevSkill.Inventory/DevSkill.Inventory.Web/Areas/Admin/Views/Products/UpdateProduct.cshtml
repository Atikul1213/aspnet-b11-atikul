@model UpdateProductModel
@{
    ViewData["Title"] = "Update Product";
}
<div class="row">
    <div class="col-12">
        <div class="card">
            <div class="card-header">
                <h5 class="mb-0">Update product</h5>
            </div>
            <div class="card-body">
                <form asp-area="Admin" asp-controller="Products" asp-action="UpdateProduct" asp-antiforgery="true" method="post" enctype="multipart/form-data">
                    <input asp-for="Id" hidden />
                    <input asp-for="Stock" hidden />
                    <input asp-for="BarcodeImagePath" hidden />
                    <input asp-for="ImageUrl" hidden />
                    <div class="row">
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label asp-for="Name" class="form-label">Product Name</label>
                                <input type="text" asp-for="Name" class="form-control" placeholder="Enter product name" required />
                                <span asp-validation-for="Name" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label asp-for="BarCode" class="form-label">Product Code</label>
                                <input type="text" asp-for="BarCode" class="form-control" placeholder="Product barcode" required />
                                <span asp-validation-for="BarCode" class="text-danger"></span>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label asp-for="CategoryId" class="form-label">Category</label>
                                <select class="form-select" asp-for="CategoryId" asp-items="Model.Categories" id="CategoryId" required>
                                </select>
                                <span asp-validation-for="CategoryId" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label asp-for="UnitId" class="form-label">Category</label>
                                <select class="form-select" asp-for="UnitId" asp-items="Model.Units" id="UnitId" required>
                                </select>
                                <span asp-validation-for="UnitId" class="text-danger"></span>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label asp-for="MRPPrice" class="form-label">MRPPrice</label>
                                <input asp-for="MRPPrice" class="form-control" type="number" />
                                <span asp-validation-for="MRPPrice" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label asp-for="Stock" class="form-label">Stock</label>
                                <input asp-for="Stock" class="form-control" type="number" />
                                <span asp-validation-for="Stock" class="text-danger"></span>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label asp-for="LowStock" class="form-label">Low Stock</label>
                                <input asp-for="LowStock" class="form-control" placeholder="Low Stock" type="number"/>
                                <span asp-validation-for="LowStock" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label asp-for="PurchasePrice" class="form-label">Purchase price</label>
                                <input type="number" asp-for="PurchasePrice" class="form-control" placeholder="Purchase price" required />
                                <span asp-validation-for="PurchasePrice" class="text-danger"></span>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label asp-for="WholeSalePrice" class="form-label">Whole sale price</label>
                                <input type="number" asp-for="WholeSalePrice" class="form-control" placeholder="Whole sale price" required />
                                <span asp-validation-for="WholeSalePrice" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label asp-for="ImageUrl" class="form-label">Product Image</label>
                                <input type="file" class="form-control" name="file" asp-for="ImageUrl" id="ImageUrl" />
                            </div>
                        </div>
                    </div>
                    <div class="mt-4">
                        <button type="submit" class="btn btn-primary">Submit</button>
                        <a asp-area="Admin" asp-controller="Products" asp-action="IndexSP" class="btn btn-secondary">Back to product list</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts
{
    <partial name="_ValidationScriptsPartial" />
}
