@model UpdateEmployeeModel

<!-- Modal -->
<div class="modal fade" id="update-employee-modal" tabindex="-1" role="dialog" aria-labelledby="exampleModalLabel" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title fw-bold" id="exampleModalLabel">Update Employee Information</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <!--begin::Form-->
                <form asp-area="Admin" asp-controller="Employees" asp-action="UpdateEmployee" asp-antiforgery="true" method="post">
                    <!--begin::Body-->
                    <div class="card-body p-3 bg-info text-white">
                        <div class="row">
                            <input asp-for="Id" hidden/>
                            <div class="mb-3 col-6">
                                <label asp-for="Name" class="form-label fw-bold">Staff / Employee Name </label>
                                <input type="text" class="form-control" asp-for="Name" id="Name" placeholder="Staff Name" aria-describedby="titleHelp" />
                                <span asp-validation-for="Name" class="text-danger"></span>
                                <div id="titleHelp" class="form-text"> </div>
                            </div>
                            <div class="col-md-6 col-6">
                                <label asp-for="DepartmentId" class="form-label fw-bold">Department</label>
                                <select class="form-select" asp-for="DepartmentId" asp-items="Model.Departments" id="DepartmentId" required>
                                </select>
                                <span asp-validation-for="DepartmentId" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="row">
                            <div class="mb-3 col-6">
                                <label asp-for="Address" class="form-label fw-bold">Address</label>
                                <input type="text" class="form-control" asp-for="Address" id="Address" placeholder="Address" aria-describedby="titleHelp" />
                                <span asp-validation-for="Address" class="text-danger"></span>
                                <div id="titleHelp" class="form-text"> </div>
                            </div>

                            <div class="mb-3 col-6">
                                <label asp-for="MobileNumber" class="form-label fw-bold">Contact Number</label>
                                <input type="text" class="form-control" asp-for="MobileNumber" id="MobileNumber" placeholder="Mobile Number" aria-describedby="titleHelp" />
                                <span asp-validation-for="MobileNumber" class="text-danger"></span>
                                <div id="titleHelp" class="form-text"> </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="mb-3 col-6">
                                <label asp-for="Email" class="form-label fw-bold">Email</label>
                                <input type="em" class="form-control" asp-for="Email" id="Email" placeholder="example@gmail.com" aria-describedby="titleHelp" />
                                <span asp-validation-for="Email" class="text-danger"></span>
                                <div id="titleHelp" class="form-text"> </div>
                            </div>

                            <div class="mb-3 col-6">
                                <label asp-for="JoiningDate" class="form-label fw-bold">Joining Date</label>
                                <input type="date" asp-for="JoiningDate" id="JoiningDate" placeholder="Joining Date" aria-describedby="titleHelp" />
                                <span asp-validation-for="JoiningDate" class="text-danger"></span>
                                <div id="titleHelp" class="form-text"> </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="mb-3 col-6">
                                <label asp-for="Salary" class="form-label fw-bold">Salary</label>
                                <input type="number" class="form-control" asp-for="Salary" id="Salary" placeholder="Salary" aria-describedby="titleHelp" />
                                <span asp-validation-for="Salary" class="text-danger"></span>
                                <div id="titleHelp" class="form-text"> </div>
                            </div>

                            <div class="mb-3 col-6">
                                <label asp-for="NIDNumber" class="form-label fw-bold">NID Number</label>
                                <input type="text" class="form-control" asp-for="NIDNumber" id="NIDNumber" placeholder="NID Number" aria-describedby="titleHelp" />
                                <span asp-validation-for="NIDNumber" class="text-danger"></span>
                                <div id="titleHelp" class="form-text"> </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-6 col-6">
                                <label asp-for="StatusId" class="form-label fw-bold">Status</label>
                                <select class="form-select" asp-for="StatusId" asp-items="Model.Status" id="StatusId" required>
                                </select>
                                <span asp-validation-for="StatusId" class="text-danger"></span>
                            </div>
                        </div>
                    </div>
                    <!--end::Body-->
                    <div class="modal-footer">
                        <button type="submit" class="btn btn-primary">Submit</button>
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    </div>
                </form>
                <!--end::Form-->
            </div>
        </div>
    </div>
</div>
