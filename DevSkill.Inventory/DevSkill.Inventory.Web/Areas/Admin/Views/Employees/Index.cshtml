@model EmployeeListModel

@{
    ViewData["Title"] = "Staff / Employee";
}

@section Styles {
    <link rel="stylesheet" href="https://cdn.datatables.net/2.3.0/css/dataTables.dataTables.min.css" />
    <link rel="stylesheet" href="https://cdn.datatables.net/buttons/3.0.2/css/buttons.dataTables.min.css">
}

<!--begin::App Content Header-->
<div class="app-content-header">
    <!--begin::Container-->
    <div class="container-fluid">
        <!--begin::Row-->
        <div class="row">
            <div class="col-sm-6"><h3 class="mb-0 fw-bold">Staff / Employee</h3></div>
            <div class="col-sm-6">
                <ol class="breadcrumb float-sm-end">
                    <li class="breadcrumb-item"><a href="#">Dashboard</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Staff / Employee</li>
                </ol>
            </div>
        </div>
        <!--end::Row-->
    </div>
    <!--end::Container-->
</div>
<!--end::App Content Header-->
<!--begin::App Content-->
<div class="app-content">
    <!--begin::Container-->
    <div class="container-fluid">
        <!--begin::Row-->
        <div class="row">
            <div class="row">
                <div class="card">
                    <div class="card-header">
                        <div class="row">
                            <div class="col-md-6"><div>Staff / Employee List</div></div>
                            <div class="col-md-6 text-end">
                                <button type="button" class="btn btn-primary btn-add-employee">
                                    <i class="bi bi-bookmark-plus-fill"></i> New Staff
                                </button>
                            </div>
                        </div>

                    </div>


                    <!-- /.card-header -->
                    <div class="card-body">
                        <table id="employee-table" class="table table-bordered">
                            <thead>
                                <tr>
                                    <th>Name</th>
                                    <th>Company</th>
                                    <th>Mobile</th>
                                    <th>Address</th>
                                    <th>Status</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                            </tbody>
                            <tfoot>
                                <tr>
                                    <th>Name</th>
                                    <th>Company</th>
                                    <th>Mobile</th>
                                    <th>Address</th>
                                    <th>Status</th>
                                    <th>Actions</th>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                    <!-- /.card-body -->

                </div>
                <!-- /.card -->
            </div>
            @Html.Partial("_EmployeeInfo", Model.AddEmployeeModel)
            @Html.Partial("_UpdateEmployeeInfo", Model.UpdateEmployeeModel)

            <!-- /.col -->
        </div>

        <!--end::Row-->
    </div>
    <!--end::Container-->
</div>
<!--end::App Content-->
@section Scripts {
    <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>
    <script src="https://cdn.datatables.net/2.2.2/js/dataTables.min.js"></script>

    <script src="https://cdn.datatables.net/buttons/3.0.2/js/dataTables.buttons.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jszip/3.10.1/jszip.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/pdfmake/0.2.7/pdfmake.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/pdfmake/0.2.7/vfs_fonts.js"></script>
    <script src="https://cdn.datatables.net/buttons/3.0.2/js/buttons.html5.min.js"></script>
    <script src="https://cdn.datatables.net/buttons/3.0.2/js/buttons.print.min.js"></script>


    <script>
        $(function(){
             $("#employee-table").DataTable({
                 processing: true,
                 serverSide: true,
                 responsive: true,
                 lengthChange: true,
                 autoWidth: false,
                 lengthMenu: [
                     [10, 25, 50, -1],
                     [10, 25, 50, 'All']
                 ],
                 dom: `Bfrtip`,
                 buttons: [
                      'copy', 'csv', 'excel', 'pdf', 'print'
                 ],

                 ajax: {
                      url: '@Url.Action("GetCQRSEmployeeJsonData", "Employees")',
                      type: 'POST',
                      contentType: "application/json",
                      datatype: 'json',
                      data: function (d) {
                          d.SearchItem = {

                          };
                          return JSON.stringify(d);
                      }
                 },
                 columnDefs: [
                     {
                         orderable: false,
                         targets: 5,
                         render: function(data, type, row){
                                return ` <a data-id="${data}"
                                                data-toggle="modal" data-target="#update-employee-modal" class="btn btn-primary btn-edit-employee"><i class="bi bi-pencil-fill"></i></a>

                                        <a href="/Admin/Employees/RemoveEmployee/${data}"  value='${data}' class="btn btn-danger">
                                                <i class="bi bi-trash-fill"></i></a>`;
                         }
                     }
                 ],
             });
        });
    </script>

    <script>
        $(document).ready(function () {
            // Handle Edit Employee button click
            $(".btn-add-employee").on("click", function () {
                $("#add-employee-modal").modal("show");
            });
        });
    </script>

    <script>
        // Handle Edit Employee button click
        $(document).on("click", ".btn-edit-employee", function () {
                let employeeId = $(this).data("id");
                var postData ={
                    employeeId: employeeId
                };
               $.ajax({
                    cache: false,
                     url: '@Url.Action("GetEmployeeDataById", "Employees")',
                     type: 'GET',
                     contentType: "application/json",
                     dataType: 'json',
                     data: postData,
                     success: function(data){
                         console.log("data: ",data);
                         console.log("test: ",data.id);
                        $("#update-employee-modal #Id").val(data.id);
                        $("#update-employee-modal #Name").val(data.name);
                        $("#update-employee-modal #Company").val(data.company);
                        $("#update-employee-modal #MobileNumber").val(data.mobileNumber);
                        $("#update-employee-modal #Address").val(data.address);
                        $("#update-employee-modal #statusId").val(data.statusId);
                        $("#update-employee-modal #OpeningBalance").val(data.openingBalance);
                        $("#update-employee-modal #Email").val(data.email);
                     },
                     error: function (xhr, status, error) {
                        console.error("AJAX Error:", error);
                    }
                }),

                $("#update-employee-modal").modal("show");
            });

    </script>

    <partial name="_ValidationScriptsPartial" />
}