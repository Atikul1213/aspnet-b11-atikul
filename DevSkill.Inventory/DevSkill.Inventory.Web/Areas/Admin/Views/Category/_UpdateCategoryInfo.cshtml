@model UpdateCategoryModel

    <!-- Modal -->
    <div class="modal fade" id="update-category" tabindex="-1" role="dialog" aria-labelledby="exampleModalLabel" aria-hidden="true">
        <div class="modal-dialog" role="document">
            <div class="modal-content">
                <div class="modal-header">
                <h5 class="modal-title fw-bold" id="exampleModalLabel">Category Information</h5>
                    <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
                <div class="modal-body">
                    <!--begin::Form-->
                    <form asp-area="Admin" asp-controller="Category" asp-action="UpdateCategory" asp-antiforgery="true" method="post">
                        <!--begin::Body-->
                        <div class="card-body">
                            <input type="hidden" asp-for="Id" />
                            <div class="mb-3">
                                 <label asp-for="Name" class="form-label fw-bold">Category Name</label>
                                <input type="text" class="form-control" asp-for="Name" id="Name"  aria-describedby="titleHelp" />
                                <span asp-validation-for="Name" class="text-danger"></span>
                                <div id="titleHelp" class="form-text"> </div>
                            </div>
                          <div class="mb-3">
                                <label asp-for="StatusId" class="form-label fw-bold">Status</label>
                                <select class="form-select" asp-for="StatusId" asp-items="Model.Status" id="statusId" required>
                                </select>
                                <span asp-validation-for="StatusId" class="text-danger"></span>
                            </div>

                        </div>
                        <!--end::Body-->
                        <div class="modal-footer">
                            <button type="submit" class="btn btn-primary">Update</button>
                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                        </div>
                    </form>
                    <!--end::Form-->
                </div>
            </div>
        </div>
    </div>
