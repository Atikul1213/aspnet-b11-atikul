@model AddCategoryModel

<!--begin::Form-->
<form asp-area="Admin" asp-controller="Category" asp-action="AddCategory" asp-antiforgery="true" method="post">
    <!--begin::Body-->
    <div class="card-body">
        <div class="mb-3">
            <label asp-for="Name" class="form-label fw-bold">Category Name</label>
            <input type="text" class="form-control" asp-for="Name" id="Name" placeholder="Category Name" aria-describedby="titleHelp" />
            <span asp-validation-for="Name" class="text-danger"></span>
            <div id="titleHelp" class="form-text"> </div>
        </div>
         <input asp-for="StatusId" type="hidden" />
    </div>
    <!--end::Body-->
    <!--begin::Footer-->
    <div class="card-footer">
        <button type="submit" class="btn btn-primary">Submit</button>
    </div>
    <!--end::Footer-->
</form>
<!--end::Form-->