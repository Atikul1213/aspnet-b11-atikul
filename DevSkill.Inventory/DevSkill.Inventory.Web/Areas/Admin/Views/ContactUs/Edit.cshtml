@model ContactUsModel
@{
    ViewData["Title"] = "Contact Us";
}
<div class="d-flex justify-content-between align-items-center mb-4">
    <h3 class="mb-0">Contact Us Content</h3>
    <a asp-area="" asp-controller="Home" asp-action="ContactUs" target="_blank" class="btn btn-outline-secondary btn-sm">
        <i class="bi bi-box-arrow-up-right me-1"></i> View Public Page
    </a>
</div>
<form asp-area="Admin" asp-controller="ContactUs" asp-action="Edit" method="post" class="row g-3" novalidate>
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <input type="hidden" asp-for="Id"/>
    <div class="col-md-6">
        <label asp-for="HeaderTitle" class="form-label"></label>
        <input asp-for="HeaderTitle" class="form-control" />
        <span asp-validation-for="HeaderTitle" class="text-danger"></span>
    </div>
    <div class="col-md-6">
        <label asp-for="HeaderSubtitle" class="form-label"></label>
        <input asp-for="HeaderSubtitle" class="form-control" />
        <span asp-validation-for="HeaderSubtitle" class="text-danger"></span>
    </div>
    <div class="col-12">
        <label asp-for="HeaderDescription" class="form-label"></label>
        <textarea asp-for="HeaderDescription" class="form-control" rows="2"></textarea>
        <span asp-validation-for="HeaderDescription" class="text-danger"></span>
    </div>
    <div class="col-md-6">
        <label asp-for="Address" class="form-label"></label>
        <textarea asp-for="Address" class="form-control" rows="3"></textarea>
        <span asp-validation-for="Address" class="text-danger"></span>
    </div>
    <div class="col-md-6">
        <label asp-for="MapEmbedUrl" class="form-label"></label>
        <textarea asp-for="MapEmbedUrl" class="form-control" rows="3"></textarea>
        <span asp-validation-for="MapEmbedUrl" class="text-danger"></span>
    </div>
    <div class="col-md-4">
        <label asp-for="Phone" class="form-label"></label>
        <input asp-for="Phone" class="form-control" />
        <span asp-validation-for="Phone" class="text-danger"></span>
    </div>
    <div class="col-md-4">
        <label asp-for="Email" class="form-label"></label>
        <input asp-for="Email" class="form-control" />
        <span asp-validation-for="Email" class="text-danger"></span>
    </div>
    <div class="col-md-4">
        <label asp-for="OpenHours" class="form-label"></label>
        <input asp-for="OpenHours" class="form-control" />
        <span asp-validation-for="OpenHours" class="text-danger"></span>
    </div>
    <div class="col-12 d-flex gap-2">
        <button type="submit" class="btn btn-primary"><i class="bi bi-save me-1"></i> Save</button>
        <a asp-area="Admin" asp-controller="Product" asp-action="IndexSP" class="btn btn-secondary">Back</a>
    </div>
</form>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
