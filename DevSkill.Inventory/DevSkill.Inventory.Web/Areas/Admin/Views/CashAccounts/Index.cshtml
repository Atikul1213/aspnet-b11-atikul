@model CashAccountListModel

@{
    ViewData["Title"] = "Cash Account";
}

<!--begin::App Content Header-->
<div class="app-content-header">
    <!--begin::Container-->
    <div class="container-fluid">
        <!--begin::Row-->
        <div class="row">
            <div class="col-sm-6"><h3 class="mb-0 fw-bold">Cash Account</h3></div>
            <div class="col-sm-6">
                <ol class="breadcrumb float-sm-end">
                    <li class="breadcrumb-item"><a href="#">Dashboard</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Cash Account</li>
                </ol>
            </div>
        </div>
        <!--end::Row-->
    </div>
    <!--end::Container-->
</div>
<!--end::App Content Header-->
<!--begin::App Content-->
<div class="app-content">
    <!--begin::Container-->
    <div class="container-fluid">
        <!--begin::Row-->
        <div class="row">
            <div class="col-8">
                <div class="card">
                    <div class="card-header"><h3 class="card-title">CashAccount List</h3></div>

                    <!-- /.card-header -->
                    <div class="card-body">
                        <table id="cashAccount-table" class="table table-bordered">
                            <thead>
                                <tr>
                                    <th class="text-center">#SN.</th>
                                    <th class="text-center">Account NAME</th>
                                    <th class="text-center">Balance</th>
                                    <th class="text-center">Current</th>
                                    <th class="text-center">ACTION</th>
                                </tr>
                            </thead>
                            <tbody>
                                <!-- Check if there are any cashAccount to display -->
                                @if (Model.CashAccounts.Any())
                                {
                                    <!-- Loop through each cashAccount in the model's cashAccount list -->
                                    var idx = 1;
                                    @foreach (var cashAccount in Model.CashAccounts)
                                    {
                                        <tr>
                                            <td class="text-center">@idx</td>
                                            <td class="text-center">@cashAccount.Name</td>
                                            <td class="text-center">@cashAccount.Balance</td>
                                            <td class="text-center">@cashAccount.CurrentBalance</td>
                                            <td class="text-center">
                                                <div class="w-75 btn-group" role="group">
                                                    <a data-id="@cashAccount.Id" data-name="@cashAccount.Name" data-statusid="@cashAccount.StatusId" data-balance="@cashAccount.Balance" data-currentBalance="@cashAccount.CurrentBalance"
                                                       data-toggle="modal" data-target="#update-cashAccount" class="btn btn-primary btn-edit-cashAccount"><i class="bi bi-pencil-fill"></i></a>

                                                    <a asp-area="Admin" asp-controller="CashAccounts" asp-action="RemoveCashAccount" asp-route-id="@cashAccount.Id" class="btn btn-danger"><i class="bi bi-trash-fill"></i></a>
                                                </div>
                                            </td>
                                        </tr>
                                        idx++;
                                    }
                                    @Html.Partial("_UpdateCashAccountInfo", Model.UpdateCashAccountModel)
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="4" class="text-center">😞 No cashAccount found.</td>
                                    </tr>
                                }
                            </tbody>
                            <tfoot>
                                <tr>
                                    <th class="text-center">#SN.</th>
                                    <th class="text-center">Account NAME</th>
                                    <th class="text-center">Balance</th>
                                    <th class="text-center">Current</th>
                                    <th class="text-center">ACTION</th>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                    <!-- /.card-body -->

                </div>
                <!-- /.card -->
            </div>
            <div class="col-4  card">
                <div class="card-header"><h3 class="card-title fw-bold">CashAccount Information</h3></div>
                @Html.Partial("_CashAccountInfo", Model.AddCashAccountModel)
                <div class="card-body">
                </div>
            </div>
            <!-- /.col -->
        </div>

        <!--end::Row-->
    </div>
    <!--end::Container-->
</div>
<!--end::App Content-->
@section Scripts {
    <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>
    <script src="https://cdn.datatables.net/2.2.2/js/dataTables.min.js"></script>

    <script>
        $(document).ready(function () {
            // Handle Edit Category button click
            $(".btn-edit-cashAccount").on("click", function () {
                const id = $(this).data("id");
                const name = $(this).data("name");
                const statusId = $(this).data("statusid");

                $("#Id").val(id);
                $("#Name").val(name);
                $("#statusId").val(statusId);

                $("#update-cashAccount").modal("show");
            });
        });
    </script>

    <partial name="_ValidationScriptsPartial" />
}