@model AddCashAccountModel

<!--begin::Form-->
<form asp-area="Admin" asp-controller="CashAccounts" asp-action="AddCashAccount" asp-antiforgery="true" method="post">
    <!--begin::Body-->
    <div class="card-body">
        <div class="mb-3">
            <label asp-for="Name" class="form-label fw-bold">Account Name</label>
            <input type="text" class="form-control" asp-for="Name" id="Name" placeholder="Account Name" aria-describedby="titleHelp" />
            <span asp-validation-for="Name" class="text-danger"></span>
            <div id="titleHelp" class="form-text"> </div>
        </div>
        <div class="mb-3">
            <label asp-for="Balance" class="form-label fw-bold">Balance</label>
            <input type="text" class="form-control" asp-for="Balance" id="Balance" placeholder="Amount" aria-describedby="titleHelp" />
            <span asp-validation-for="Balance" class="text-danger"></span>
            <div id="titleHelp" class="form-text"> </div>
        </div>

        <input asp-for="StatusId" type="hidden" />
        <input asp-for="CurrentBalance" type="hidden" />
    </div>
    <!--end::Body-->
    <!--begin::Footer-->
    <div class="card-footer">
        <button type="submit" class="btn btn-primary">Submit</button>
    </div>
    <!--end::Footer-->
</form>
<!--end::Form-->