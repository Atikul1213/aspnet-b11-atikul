@model AddCustomerModel


<!-- Modal -->
<div class="modal fade" id="add-customer-modal" tabindex="-1" role="dialog" aria-labelledby="exampleModalLabel" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title fw-bold" id="exampleModalLabel">New Customer Information</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <!--begin::Form-->
                <form asp-area="Admin" asp-controller="Customers" asp-action="AddCustomer" asp-antiforgery="true" method="post" enctype="multipart/form-data">
                    <!--begin::Body-->
                    <div style="background-color:#738199;" class="card-body p-3   text-white">
                        <div class="row">
                            <div class="mb-3 col-6">
                                <label asp-for="Name" class="form-label fw-bold">Customer Name </label>
                                <input type="text" class="form-control" asp-for="Name" id="Name" placeholder="Customer Name" aria-describedby="titleHelp" />
                                <span asp-validation-for="Name" class="text-danger"></span>
                                <div id="titleHelp" class="form-text"> </div>
                            </div>

                            <div class="mb-3 col-6">
                                <label asp-for="CompanyName" class="form-label fw-bold">Company Name</label>
                                <input type="text" class="form-control" asp-for="CompanyName" id="CompanyName" placeholder="Company Name" aria-describedby="titleHelp" />
                                <span asp-validation-for="CompanyName" class="text-danger"></span>
                                <div id="titleHelp" class="form-text"> </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="mb-3 col-6">
                                <label asp-for="MobileNumber" class="form-label fw-bold">Mobile Number</label>
                                <input type="text" class="form-control" asp-for="MobileNumber" id="MobileNumber" placeholder="Mobile Number" aria-describedby="titleHelp" />
                                <span asp-validation-for="MobileNumber" class="text-danger"></span>
                                <div id="titleHelp" class="form-text"> </div>
                            </div>
                            <div class="mb-3 col-6">
                                <label asp-for="Address" class="form-label fw-bold">Address</label>
                                <input type="text" class="form-control" asp-for="Address" id="Address" placeholder="Address" aria-describedby="titleHelp" />
                                <span asp-validation-for="Address" class="text-danger"></span>
                                <div id="titleHelp" class="form-text"> </div>
                            </div>
                        </div>

                        <div class="row">

                            <div class="mb-3 col-6">
                                <label asp-for="Email" class="form-label fw-bold">Email</label>
                                <input type="text" class="form-control" asp-for="Email" id="Email" placeholder="example@gmail.com" aria-describedby="titleHelp" />
                                <span asp-validation-for="Email" class="text-danger"></span>
                                <div id="titleHelp" class="form-text"> </div>
                            </div>

                            <div class="mb-3 col-6">
                                <label asp-for="OpeningBalance" class="form-label fw-bold">Opening Balance</label>
                                <input type="text" class="form-control" asp-for="OpeningBalance" id="OpeningBalance" placeholder="Opening Balance" aria-describedby="titleHelp" />
                                <span asp-validation-for="OpeningBalance" class="text-danger"></span>
                                <div id="titleHelp" class="form-text"> </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="mb-3 col-6">
                                <label asp-for="StatusId" class="form-label fw-bold">Status</label>
                                <select class="form-select" asp-for="StatusId" asp-items="Model.Status" id="statusId" required>
                                </select>
                                <span asp-validation-for="StatusId" class="text-danger"></span>
                            </div>

                            <div class="mb-3 col-6">
                                <label asp-for="ImageUrl" class="form-label fw-bold">Customer Image</label>
                                <input type="file" class="form-control" name="file" asp-for="ImageUrl" id="ImageUrl" aria-describedby="titleHelp" />
                            </div>
                        </div>
                    </div>
                    <!--end::Body-->
                    <div class="modal-footer">
                        <button type="submit" class="btn btn-primary">Submit</button>
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    </div>
                </form>
                <!--end::Form-->
            </div>
        </div>
    </div>
</div>
