@model CustomerListModel

@{
    ViewData["Title"] = "Customer";
}

@section Styles {
    <link rel="stylesheet" href="https://cdn.datatables.net/2.3.0/css/dataTables.dataTables.min.css" />
    <link rel="stylesheet" href="https://cdn.datatables.net/buttons/3.0.2/css/buttons.dataTables.min.css">
}

<!--begin::App Content Header-->
<div class="app-content-header">
    <!--begin::Container-->
    <div class="container-fluid">
        <!--begin::Row-->
        <div class="row">
            <div class="col-sm-6"><h3 class="mb-0 fw-bold">Customer</h3></div>
            <div class="col-sm-6">
                <ol class="breadcrumb float-sm-end">
                    <li class="breadcrumb-item"><a href="#">Dashboard</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Customer</li>
                </ol>
            </div>
        </div>
        <!--end::Row-->
    </div>
    <!--end::Container-->
</div>
<!--end::App Content Header-->
<!--begin::App Content-->
<div class="app-content">
    <!--begin::Container-->
    <div class="container-fluid">

            <div class="col-12">
                <div class="card">
                    <div class="card-header">
                        <div class="row">
                            <div class="col-md-6  fw-bold"><div>Customer List</div></div>
                            <div class="col-md-6 text-end">
                                <button type="button" class="btn btn-primary btn-add-customer">
                                    <i class="bi bi-bookmark-plus-fill"></i> New Customer
                                </button>
                            </div>
                        </div>
                        <div class="card-tools">
                            <button type="button" class="btn btn-tool" data-card-widget="collapse">
                                <i class="fas fa-plus"></i>
                            </button>
                        </div>
                    </div>
                    <!-- /.card-header -->
                <div style="background-color:#738199;" class="card-body  p-3  text-white">
                        <div class="row">
                            <div class="col-sm-3">
                                <div class="form-group">
                                    <label>Name</label>
                                    <input type="text" asp-for="SearchItem.Name" class="form-control" />
                                </div>
                            </div>
                            <div class="col-sm-3">
                                <div class="form-group">
                                    <label>Email</label>
                                    <input type="text" asp-for="SearchItem.Email" class="form-control" />
                                </div>
                            </div>
                            <div class="col-sm-3">
                                <div class="form-group">
                                    <label>Company Name</label>
                                    <input type="text" asp-for="SearchItem.CompanyName" class="form-control" />
                                </div>
                            </div>
                            <div class="col-sm-3">
                                <div class="form-group">
                                    <label>Mobile Number</label>
                                    <input type="text" asp-for="SearchItem.MobileNumber" class="form-control" />
                                </div>
                            </div>
                            <div class="col-sm-3">
                                <div class="form-group">
                                    <label>Balance From</label>
                                    <input type="number" asp-for="SearchItem.BalanceFrom" class="form-control" />
                                </div>
                            </div>
                            <div class="col-sm-3">
                                <div class="form-group">
                                    <label>Balance To</label>
                                    <input type="number" asp-for="SearchItem.BalanceTo" class="form-control" />
                                </div>
                            </div>
                        </div>
                    </div>
                    <!-- /.card-body -->
                    <div class="card-footer">
                        <button id="searchButton" type="submit" class="btn btn-primary float-right">Search</button>
                    </div>
                </div>
            </div>

        <!--begin::Row-->
        <div class="row">
            <div class="col-md-12">
                <div class="card">
                    <div class="card-header"><h3 class="card-title">Available Customers</h3></div>
                    <!-- /.card-header -->
                    <div class="card-body">
                        <table id="customer-table" class="table table-bordered text-center table-hover">
                            <thead>
                                <tr class="table-primary">
                                    <th>Image</th>
                                    <th>Name</th>
                                    <th>Mobile</th>
                                    <th>Address</th>
                                    <th>Email</th>
                                    <th>Current Balance</th>
                                    <th>Status</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                            </tbody>
                            <tfoot>
                                <tr class="table-primary">
                                    <th>Image</th>
                                    <th>Name</th>
                                    <th>Mobile</th>
                                    <th>Address</th>
                                    <th>Email</th>
                                    <th>Current Balance</th>
                                    <th>Status</th>
                                    <th>Actions</th>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                    <!-- /.card-body -->

                </div>
                <!-- /.card -->
            @Html.Partial("_CustomerInfo", Model.AddCustomerModel)
            @Html.Partial("_UpdateCustomerInfo", Model.UpdateCustomerModel)

            </div>
            <!-- /.col -->
        </div>
        <!--end::Row-->
    </div>
    <!--end::Container-->
</div>
<!--end::App Content-->
@section Scripts {
    <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>
    <script src="https://cdn.datatables.net/2.2.2/js/dataTables.min.js"></script>

    <script src="https://cdn.datatables.net/buttons/3.0.2/js/dataTables.buttons.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jszip/3.10.1/jszip.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/pdfmake/0.2.7/pdfmake.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/pdfmake/0.2.7/vfs_fonts.js"></script>
    <script src="https://cdn.datatables.net/buttons/3.0.2/js/buttons.html5.min.js"></script>
    <script src="https://cdn.datatables.net/buttons/3.0.2/js/buttons.print.min.js"></script>


    <script>
        $(function(){
             $("#customer-table").DataTable({
                 processing: true,
                 serverSide: true,
                 responsive: true,
                 lengthChange: true,
                 autoWidth: false,
                 searching: false,
                 lengthMenu: [
                     [10, 25, 50, -1],
                     [10, 25, 50, 'All']
                 ],
                 dom: `Bfrtip`,
                 buttons: [
                      'copy', 'csv', 'excel', 'pdf', 'print'
                 ],

                 ajax: {
                      url: '@Url.Action("GetCQRSCustomerJsonData", "Customers")',
                      type: 'POST',
                      contentType: "application/json",
                      datatype: 'json',
                      data: function (d) {
                          d.SearchItem = {
                                Name: $("#SearchItem_Name").val(),
                                Email: $("#SearchItem_Email").val(),
                                CompanyName: $("#SearchItem_CompanyName").val(),
                                MobileNumber: $("#SearchItem_MobileNumber").val(),
                                BalanceFrom: $("#SearchItem_BalanceFrom").val() == "" ? null : $("#SearchItem_BalanceFrom").val(),
                                BalanceTo: $("#SearchItem_BalanceTo").val() == "" ? null : $("#SearchItem_BalanceTo").val()
                          };
                          return JSON.stringify(d);
                      }
                 },
                 columnDefs: [
                    {
                        targets: 0,
                        orderable: false,
                        render: function (data, type, row) {
                            return `<img src="${data}" alt="Customer Image" width="80" height="80" style="object-fit: contain;" />`;
                        }
                    },
                     {
                         orderable: false,
                         targets: 7,
                         render: function(data, type, row){
                                return `<a href="/Admin/Customers/ShowCustomer/${data}"  value='${data}' class="btn btn-danger">
                                               <i class="bi bi-eye-fill"></i></a>
                                <a data-id="${data}" data-toggle="modal" data-target="#update-customer-modal" class="btn btn-primary btn-edit-customer">
                                            <i class="bi bi-pencil-fill"></i></a>
                                <a href="/Admin/Customers/RemoveCustomer/${data}"  value='${data}' class="btn btn-danger">
                                                <i class="bi bi-trash-fill"></i></a>`;
                         }
                     }
                 ],
             });

              $("#searchButton").on('click', function(){
                  $("#customer-table").DataTable().ajax.reload(null, false);
              });

        });
    </script>

    <script>
        $(document).ready(function () {
            // Handle Edit Customer button click
            $(".btn-add-customer").on("click", function () {
                $("#add-customer-modal").modal("show");
            });
        });
    </script>

    <script>
        // Handle Edit Customer button click
        $(document).on("click", ".btn-edit-customer", function () {
                let customerId = $(this).data("id");
                var postData ={
                    customerId: customerId
                };
               $.ajax({
                    cache: false,
                     url: '@Url.Action("GetCustomerDataById", "Customers")',
                     type: 'GET',
                     contentType: "application/json",
                     dataType: 'json',
                     data: postData,
                     success: function(data){
                          console.log("data: ",data);
                         // console.log("test: ",data.id);
                        $("#update-customer-modal #Id").val(data.id);
                        $("#update-customer-modal #Name").val(data.name);
                        $("#update-customer-modal #CompanyName").val(data.companyName);
                        $("#update-customer-modal #MobileNumber").val(data.mobileNumber);
                        $("#update-customer-modal #Address").val(data.address);
                        $("#update-customer-modal #statusId").val(data.statusId);
                        $("#update-customer-modal #ImageUrl").val(data.imageUrl);
                        $("#update-customer-modal #OpeningBalance").val(data.openingBalance);
                        $("#update-customer-modal #Email").val(data.email);
                     },
                     error: function (xhr, status, error) {
                        console.error("AJAX Error:", error);
                    }
                }),

                $("#update-customer-modal").modal("show");
            });

    </script>

    <partial name="_ValidationScriptsPartial" />
}