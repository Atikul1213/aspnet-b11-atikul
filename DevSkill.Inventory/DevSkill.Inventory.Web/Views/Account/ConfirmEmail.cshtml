@model ConfirmEmailModel
@{
    ViewData["Title"] = "Email Confirmation";
}


<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">

            <div class="card shadow-lg rounded-3">
                <div class="card-body text-center p-4">
                    @if (Model.IsSuccess)
                    {
                        <h2 class="text-success mb-3">🎉 Email Confirmed</h2>
                        <p class="text-muted">
                            Thank you, your email address has been successfully verified.
                            You can now <a asp-action="Login" asp-controller="Account">log in</a>.
                        </p>
                    }
                    else
                    {
                        <h2 class="text-danger mb-3">⚠️ Email Confirmation Failed</h2>
                        <p class="text-muted">@Model.ErrorMessage</p>

                        @if (!string.IsNullOrEmpty(Model.email))
                        {
                            <form asp-action="ResendConfirmationEmail" asp-controller="Account" method="post">
                                <input type="hidden" asp-for="email" />
                                <input type="hidden" asp-for="returnUrl" />
                                <button type="submit" class="btn btn-primary mt-3">
                                    Resend Confirmation Email
                                </button>
                            </form>
                        }
                        else
                        {
                            <p class="mt-3">
                                Please try registering again or contact support.
                            </p>
                        }
                    }
                </div>
            </div>

        </div>
    </div>
</div>
