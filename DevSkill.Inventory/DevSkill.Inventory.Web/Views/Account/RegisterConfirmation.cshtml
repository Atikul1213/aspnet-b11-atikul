@model RegisterConfirmationModel
@{
    ViewData["Title"] = "Email Confirmation Required";
}


<div class="d-flex justify-content-center align-items-center mt-5">
    <div class="card shadow-lg border-0 rounded-4 p-4" style="max-width: 500px; width: 100%;">
        <div class="card-body text-center">
            <div class="mb-3">
                <i class="bi bi-envelope-check-fill text-warning" style="font-size: 3rem;"></i>
            </div>

            @if (!string.IsNullOrEmpty(Model.Message))
            {
                <h3 class="fw-bold text-warning">Email Confirmation Required</h3>
                <p class="mt-3 text-muted">@Model.Message</p>
            }
            else
            {
                <h3 class="fw-bold text-primary">Thank you for registering!</h3>
                <p class="mt-3 text-muted">
                    We've sent a confirmation link to <strong>@Model.Email</strong>.
                </p>
            }

            <p class="text-muted">
                Please check your inbox (and spam folder) and click the confirmation link to verify your account.
            </p>

            <div class="mt-4 p-3 bg-light rounded-3">
                <p class="text-muted small mb-2">
                    <strong>Didn't receive the email?</strong>
                </p>
                <form asp-action="ResendConfirmationEmail" asp-controller="Account" method="post" class="d-inline">
                    <input type="hidden" name="email" value="@Model.Email" />
                    <input type="hidden" name="returnUrl" value="@Model.ReturnUrl" />
                    <button type="submit" class="btn btn-primary btn-sm rounded-pill px-3">
                        <i class="bi bi-envelope-arrow-up me-1"></i> Resend Confirmation Email
                    </button>
                </form>
            </div>

            <div class="mt-4">
                <a class="btn btn-outline-secondary btn-sm rounded-pill px-4 me-2" asp-action="Login" asp-controller="Account">
                    <i class="bi bi-box-arrow-in-right me-2"></i> Back to Login
                </a>
                @if (!string.IsNullOrEmpty(Model.ReturnUrl) && Model.ReturnUrl != "/")
                {
                    <a class="btn btn-secondary btn-sm rounded-pill px-4" href="@Model.ReturnUrl">
                        <i class="bi bi-arrow-left-circle me-2"></i> Go Back
                    </a>
                }
            </div>
        </div>
    </div>
</div>
