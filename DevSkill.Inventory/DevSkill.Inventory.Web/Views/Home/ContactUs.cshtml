@model ContactUsInfoModel
@inject IConfiguration Configuration
@{
    ViewData["Title"] = Model.HeaderTitle;
    var reCaptchaSiteKey = Configuration["GoogleReCaptcha:SiteKey"];
}

<!-- Page Header Section -->
<section class="section position-relative" style=" padding-top: 2rem;">
    <div class="container">
        <div class="text-center mb-2" data-aos="fade-up">
            <h1 class="display-4 fw-bold text-primary mb-3">@Model.HeaderTitle</h1>
            <p class="lead text-muted">@Model.HeaderSubtitle</p>
            <p class="fs-5">@Model.HeaderDescription</p>
        </div>
    </div>
</section>

<!-- Contact Section -->
<section class="contact section py-5">
    <div class="container">
        <div class="row g-5">
            <div class="col-lg-6">
                <div class="h-100 d-flex flex-column">
                    <div class="row g-4 mb-4">
                        <div class="col-md-6">
                            <div class="info-card h-100 p-4 bg-light rounded-4 text-center">
                                <div class="icon mb-3">
                                    <i class="bi bi-geo-alt text-primary fs-1"></i>
                                </div>
                                <h5 class="fw-bold mb-2">Our Address</h5>
                                <p class="text-muted mb-0" style="white-space:pre-line">@Model.Address</p>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="info-card h-100 p-4 bg-light rounded-4 text-center">
                                <div class="icon mb-3">
                                    <i class="bi bi-telephone text-primary fs-1"></i>
                                </div>
                                <h5 class="fw-bold mb-2">Call Us</h5>
                                <p class="text-muted mb-0">
                                    <a href="tel:@Model.Phone" class="text-decoration-none text-muted">@Model.Phone</a>
                                </p>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="info-card h-100 p-4 bg-light rounded-4 text-center">
                                <div class="icon mb-3">
                                    <i class="bi bi-envelope text-primary fs-1"></i>
                                </div>
                                <h5 class="fw-bold mb-2">Email Us</h5>
                                <p class="text-muted mb-0">
                                    <a href="mailto:@Model.Email" class="text-decoration-none text-muted">@Model.Email</a>
                                </p>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="info-card h-100 p-4 bg-light rounded-4 text-center">
                                <div class="icon mb-3">
                                    <i class="bi bi-clock text-primary fs-1"></i>
                                </div>
                                <h5 class="fw-bold mb-2">Open Hours</h5>
                                <p class="text-muted mb-0">@Model.OpenHours</p>
                            </div>
                        </div>
                    </div>

                    <!-- Google Map -->
                    <div class="map-container flex-grow-1">
                        <div class="ratio ratio-16x9 rounded-4 overflow-hidden shadow">
                            @if (!string.IsNullOrWhiteSpace(Model.MapEmbedUrl))
                            {
                                <iframe src="@Model.MapEmbedUrl"
                                        style="border:0; width: 100%; height: 100%;"
                                        allowfullscreen=""
                                        loading="lazy"
                                        referrerpolicy="no-referrer-when-downgrade"
                                        title="Office Location">
                                </iframe>
                            }
                        </div>
                    </div>
                </div>
            </div>

            <!-- Right Column: Contact Form -->
            <div class="col-lg-6">
                <div class="contact-form-container h-100 d-flex flex-column">
                    @if (TempData["SuccessMessage"] != null)
                    {
                        <div class="alert alert-success alert-dismissible fade show mb-4" role="alert">
                            <i class="bi bi-check-circle-fill me-2"></i>
                            @TempData["SuccessMessage"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>
                    }
                    @if (TempData["ErrorMessage"] != null)
                    {
                        <div class="alert alert-danger alert-dismissible fade show mb-4" role="alert">
                            <i class="bi bi-exclamation-triangle-fill me-2"></i>
                            @TempData["ErrorMessage"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>
                    }
                    <div class="mb-4">
                        <h3 class="fw-bold mb-3">Send Message</h3>
                        <p class="text-muted">Have a question? Drop us a line!</p>
                    </div>

                    <form asp-action="ContactUs" method="post" asp-antiforgery="true" novalidate class="needs-validation flex-grow-1 d-flex flex-column">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
                        <div class="row g-3 flex-grow-1 d-flex flex-column">
                            <div class="col-12">
                                <label asp-for="Name" class="form-label fw-semibold fs-5">
                                    <i class="bi bi-person me-2"></i>Your Name *
                                </label>
                                <input asp-for="Name" class="form-control form-control-lg" placeholder="Enter your full name" />
                                <span asp-validation-for="Name" class="text-danger small"></span>
                            </div>
                            <div class="col-12">
                                <label asp-for="UserEmail" class="form-label fw-semibold fs-5">
                                    <i class="bi bi-envelope me-2"></i>Your Email Address *
                                </label>
                                <input asp-for="UserEmail" class="form-control form-control-lg" placeholder="Enter your email address" />
                                <span asp-validation-for="UserEmail" class="text-danger small"></span>
                            </div>
                            <div class="col-12">
                                <label asp-for="UserPhone" class="form-label fw-semibold fs-5">
                                    <i class="bi bi-phone me-2"></i>Your Phone Number <span class="text-muted">(Optional)</span>
                                </label>
                                <input asp-for="UserPhone" class="form-control form-control-lg" placeholder="+8801XXXXXXXXX" />
                                <span asp-validation-for="UserPhone" class="text-danger small"></span>
                            </div>
                            <div class="col-12 flex-grow-1 d-flex flex-column">
                                <label asp-for="Message" class="form-label fw-semibold fs-5">
                                    <i class="bi bi-chat-dots me-2"></i>Your Message *
                                </label>
                                <textarea asp-for="Message" class="form-control form-control-lg flex-grow-1"
                                          rows="6" placeholder="Tell us about your project, question, or how we can help you..."></textarea>
                                <span asp-validation-for="Message" class="text-danger small"></span>
                            </div>
                            <div class="col-12 pt-3">
                                <button type="submit" class="g-recaptcha btn btn-primary btn-lg w-100 py-3"
                                        data-sitekey="@reCaptchaSiteKey"
                                        data-callback="onRecaptchaSubmit"
                                        data-action="submit">
                                    <i class="bi bi-send me-2"></i>Send Message
                                </button>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <partial name="_ReCaptchaPartial" />
    <script>
        $(document).ready(function () {
            'use strict';
            // Auto-dismiss both success and error alerts after 15 seconds
            setTimeout(function() { $('.alert-success, .alert-danger').fadeOut('slow'); }, 15000);
            $('form.needs-validation').on('submit', function(event) {
                if (!this.checkValidity()) {
                    event.preventDefault();
                    event.stopPropagation();
                }
                $(this).addClass('was-validated');
            });
            $('.form-control').on('input', function() {
                $(this).removeClass('is-invalid is-valid');
                $(this).closest('form').removeClass('was-validated');
            });
        });
    </script>
}

@section Styles {
    <style>
        .info-card { transition: transform 0.3s ease, box-shadow 0.3s ease; border: 1px solid rgba(0,0,0,0.05); }
        .info-card:hover { transform: translateY(-5px); box-shadow: 0 10px 30px rgba(0,0,0,0.1); }
        .contact-form-container { background: linear-gradient(135deg, #f8f9fa 0%, #ffffff 100%); border-radius: 1rem; padding: 2rem; box-shadow: 0 5px 20px rgba(0,0,0,0.08); }
        .form-control:focus { border-color: var(--bs-primary); box-shadow: 0 0 0 0.2rem rgba(var(--bs-primary-rgb), 0.25); }
        .btn-primary { background: linear-gradient(135deg, var(--bs-primary) 0%, #0056b3 100%); border: none; transition: all 0.3s ease; }
        .btn-primary:hover { transform: translateY(-2px); box-shadow: 0 8px 25px rgba(var(--bs-primary-rgb), 0.3); }
        .map-container iframe { filter: grayscale(20%); transition: filter 0.3s ease; }
        .map-container:hover iframe { filter: grayscale(0%); }
        .contact-form-container .form-label { font-size: 1.075rem; }
        @@media (min-width: 992px){ .contact-form-container .form-label { font-size: 1.1rem; } }
    </style>
}
