@model ErrorViewModel
@{
    ViewData["Title"] = $"{Model.StatusCode} - {Model.Title}";
}

@section Styles {
    <link rel="stylesheet" href="~/sneat/assets/vendor/css/core.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/sneat/assets/css/demo.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/sneat/assets/vendor/css/pages/page-misc.css" asp-append-version="true" />
}

<div class="container-xxl container-p-y">
    <div class="misc-wrapper">
        <h1 class="status-code">@Model.StatusCode</h1>
        <h4 class="error-title">@Model.Title ⚠️</h4>
        <p class="error-message">@Model.ErrorMessage</p>

        @if (!string.IsNullOrEmpty(Model.TraceId))
        {
            <p class="trace-id"><small>Error ID: @Model.TraceId</small></p>
        }

        <a href="/" class="btn btn-primary mt-3">⬅ Back to Home</a>

        <div class="mt-6">
            <img src="~/sneat/assets/img/illustrations/page-misc-error-light.png"
                 asp-append-version="true"
                 alt="error-illustration"
                 width="500"
                 class="img-fluid" />
        </div>
    </div>
</div>

